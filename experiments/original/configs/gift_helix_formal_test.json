    },
    "bitbrains_fast_5T": {
      "path": "data/GiftEval/bitbrains_fast_storage/5T",
      "prediction_length": 48,
      "imputer_path": "artifacts/helix/bitbrains_fast_5T_seed2021"
    },
    "bitbrains_rnd_5T": {
      "path": "data/GiftEval/bitbrains_rnd/5T",
      "prediction_length": 48,
